{
  "name": "imprint",
  "version": "0.1.0",
  "private": true,
  "description": "A dual-source content platform: a from-scratch CMS whose schema language drives storage, editor, API and render — plus typed bindings and build gates.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx packages/cli/src/index.ts seed",
    "gates": "tsx packages/cli/src/index.ts gates",
    "doctor": "tsx packages/cli/src/index.ts doctor",
    "migrate": "tsx packages/cli/src/index.ts migrate",
    "imprint": "tsx packages/cli/src/index.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
